generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.UniqueIdentifier
  email        String   @unique @db.NVarChar(320)
  passwordHash String   @db.NVarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connections BrokerageConnection[]
}

model BrokerageConnection {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  userId         String   @db.UniqueIdentifier
  brokerId       String   @db.NVarChar(64)
  encryptedToken String   @db.NVarChar(Max)
  status         String   @default("pending") @db.NVarChar(32)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]
  syncRuns SyncRun[]

  @@unique([userId, brokerId])
  @@index([userId])
  @@index([brokerId])
  @@index([status])
}

model Account {
  id              String @id @default(uuid()) @db.UniqueIdentifier
  connectionId    String @db.UniqueIdentifier
  brokerAccountId String @db.NVarChar(128)
  name            String @db.NVarChar(255)
  type            String @db.NVarChar(64)

  connection BrokerageConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  holdings   Holding[]

  @@unique([connectionId, brokerAccountId])
  @@index([connectionId])
}

model Holding {
  id           String   @id @default(uuid()) @db.UniqueIdentifier
  accountId    String   @db.UniqueIdentifier
  ticker       String   @db.NVarChar(32)
  quantity     Decimal  @db.Decimal(18, 6)
  price        Decimal  @db.Decimal(18, 4)
  marketValue  Decimal  @db.Decimal(18, 2)
  lastSyncedAt DateTime

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, ticker])
  @@index([accountId])
  @@index([ticker])
}

model SyncRun {
  id           String    @id @default(uuid()) @db.UniqueIdentifier
  connectionId String    @db.UniqueIdentifier
  status       String    @db.NVarChar(32)
  itemsSynced  Int       @default(0)
  error        String?   @db.NVarChar(Max)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  connection BrokerageConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([startedAt])
}
